# ============================================================
# 人生选择器 配置
# 复制本文件为 .env 并填入你的 key：cp .env.example .env
# 两个 key 都可以不填 —— 应用会进入「演示模式」，界面照常可用
# ============================================================

# ---------- LLM（OpenAI 兼容接口，负责生成选项） ----------
# DeepSeek 示例：
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# 其他常见服务商（取消注释替换即可）：
# Kimi/Moonshot:  OPENAI_BASE_URL=https://api.moonshot.cn/v1                          OPENAI_MODEL=moonshot-v1-8k
# 通义千问:       OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   OPENAI_MODEL=qwen-plus
# 智谱 GLM:       OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4                OPENAI_MODEL=glm-4-flash
# OpenAI:         OPENAI_BASE_URL=https://api.openai.com/v1                           OPENAI_MODEL=gpt-4o-mini

# ---------- Jev（TypeSafe AI System One，负责最终决定） ----------
# API Key 在控制台申请：https://console.typesafe.ai/settings/keys
# 计价参考：输入 $0.042 / 百万 tokens，输出免费
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=https://api.typesafe.ai
JEV_MODEL=jev-latest

# ---------- 服务端口 / 监听地址 ----------
# HOST=0.0.0.0 表示监听所有网卡，内网其他设备可通过 http://本机IP:3000 访问
# 只想本机访问就改成 HOST=127.0.0.1
PORT=3000
HOST=0.0.0.0
